# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (Grupo Javida)
# Copia este archivo como .env en la raíz y coloca los valores correspondientes.
# ==============================================================================

# Clave pública del sitio de Google reCAPTCHA v2 (Invisible o Checkbox)
VITE_RECAPTCHA_SITE_KEY=tu_site_key_de_recaptcha_aqui

# URL del endpoint backend para el envío del formulario de contacto
# En desarrollo local: http://localhost:8000/sendEmail.php
# En producción: https://javida.com.mx/sendEmail.php
LOCAL_VITE_API_URL=http://localhost/backend_lading_page_javida_v2/sendEmail.php
VITE_API_URL=https://javida.com.mx/backend_lading_page_javida_v2/sendEmail.php